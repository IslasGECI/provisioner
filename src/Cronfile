# Environment variables
SHELL=/bin/bash

# Development server: islasgeci.dev
10 6 * * 1-5 docker pull islasgeci/development_server_setup:latest && source /home/geci/.vault/.secrets && docker run --env AZURE_PASSWORD --env AZURE_USERNAME --rm --volume /home/geci/.ssh:/root/.ssh --volume development_server_setup:/workdir/src islasgeci/development_server_setup:latest
40 6 * * 1-5 docker pull islasgeci/development_server_setup:latest && source /home/geci/.vault/.secrets && docker run --env AZURE_PASSWORD --env AZURE_USERNAME --rm --volume /home/geci/.ssh:/root/.ssh --volume development_server_setup:/workdir/src islasgeci/development_server_setup:latest
40 15 * * 1-5 source /home/geci/.vault/.secrets && docker run --env AZURE_PASSWORD --env AZURE_USERNAME --rm --volume /home/geci/.ssh:/root/.ssh --volume development_server_setup:/workdir/src islasgeci/development_server_setup:latest make destroy_server

# Web server: islasgeci.org
20 15 * * 0-4 source /home/geci/.vault/.secrets && docker run --env AZURE_PASSWORD --env AZURE_USERNAME --rm --volume /home/geci/.ssh:/root/.ssh --volume islasgeci.org_setup:/workdir/src islasgeci/islasgeci.org_setup:latest make destroy_server
40 15 * * 0-4 docker pull islasgeci/islasgeci.org_setup:latest && source /home/geci/.vault/.secrets && docker run --env AZURE_PASSWORD --env AZURE_USERNAME --rm --volume /home/geci/.ssh:/root/.ssh --volume /home/geci/.vault:/root/.vault --volume islasgeci.org_setup:/workdir/src islasgeci/islasgeci.org_setup:latest

# Health checks
0 * * * * curl -fsS -m 10 --retry 5 -o /dev/null https://hc-ping.com/c48ff6b9-56e8-418c-83a2-dba0c98c84d3

# Docker prune
@daily docker image prune --all --force
